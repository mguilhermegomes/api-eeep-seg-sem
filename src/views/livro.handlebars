<form action="/livros" method="post">
    <div class="form-campo">
        <label for="input_titulo">Titulo</label>
        <input type="text" name="titulo" id="input_titulo" placeholder="Titulo" required>
    </div>

    <div class="form-campo">
        <label for="input_autor">Autor</label>
        <input type="text" name="autor" id="input_autor" placeholder="Autor" required>
    </div>

    <div class="form-campo">
        <label for="input_ano">Ano</label>
        <input type="number" name="ano" id="input_ano" placeholder="Ano" required>
    </div>

    <div class="form-campo">
        <label for="input_exemplares">Exemplares</label>
        <input type="number" name="exemplares" id="input_exemplares" placeholder="Exemplares" required>
    </div>

    <button type="submit">Cadastrar</button>
</form>

<table border="2">
    <thead>
        <tr>
            <th>Titulo</th>
            <th>Autor</th>
            <th>Ano</th>
            <th>Disponiveis</th>
            <th>Situação</th>
        </tr>
    </thead>
    <tbody>
        {{#each livros}}
            <tr>
                <td>{{this.titulo}}</td>
                <td>{{this.autor}}</td>
                <td>{{this.ano}}</td>
                <td>{{this.disponiveis}} de {{this.exemplares}}</td>
                {{#if this.disponivel}}
                    <td style="background-color: #bafe53;">{{this.situacao}}</td>
                {{else}}
                    <td style="background-color: #fa5757;">{{this.situacao}}</td>
                {{/if}}
            </tr>
        {{else}}
            <tr>
                <td colspan="5">Nenhum livro cadastrado</td>
            </tr>
        {{/each}}
    </tbody>
</table>